{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "devdock",
  "version": "0.1.0",
  "identifier": "com.devdock.app",
  "build": {
    "beforeDevCommand": "pnpm start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist/devdock/browser"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DevDock",
        "width": 560,
        "height": 520,
        "x": 400,
        "y": 480,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "visible": true,
        "shadow": false
      }
    ],
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "PLACEHOLDER_PUBLIC_KEY",
      "endpoints": [
        "https://devdock-updater.PLACEHOLDER_ACCOUNT.workers.dev/{{target}}/{{arch}}/{{current_version}}"
      ],
      "dialog": true
    }
  }
}
